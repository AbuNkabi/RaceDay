@model EventFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="EventName" class="form-label"></label>
    <input asp-for="EventName" class="form-control" />
    <span asp-validation-for="EventName" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" class="form-control" />
        <span asp-validation-for="EventDate" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
</div>
<div class="mb-3">
    <label asp-for="Image" class="form-label"></label>
    @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
    {
        <div class="mb-2">
            <img src="@Model.ExistingImageUrl" alt="Current image" style="max-height:140px" class="rounded border" />
            <div class="form-text">Choose a new file below to replace this image.</div>
        </div>
    }
    <input asp-for="Image" type="file" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" />
    <div class="form-text">JPG, PNG, GIF or WebP, up to 5 MB. Stored in Azure Blob Storage.</div>
    <span asp-validation-for="Image" class="text-danger"></span>
</div>
