@model List<EventModel>
@{ ViewData["Title"] = "Browse Events"; }

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Browse events</h1>
    <form method="get" class="d-flex" role="search">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control me-2"
               placeholder="Search by name or location" />
        <button class="btn btn-outline-primary" type="submit">Search</button>
    </form>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No events found.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var e in Model)
        {
            <div class="col"><partial name="_EventCard" model="e" /></div>
        }
    </div>
}
