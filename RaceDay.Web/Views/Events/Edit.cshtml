@model EventFormViewModel
@{ ViewData["Title"] = "Edit Event"; }

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4 mb-3">Edit event</h1>
                <form asp-action="Edit" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data">
                    <partial name="_EventForm" model="Model" />
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a asp-action="Mine" class="btn btn-link">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
