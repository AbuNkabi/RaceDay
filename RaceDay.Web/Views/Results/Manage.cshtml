@model ManageResultsViewModel
@{ ViewData["Title"] = "Manage Results"; }

<a asp-controller="Events" asp-action="Mine" class="text-decoration-none">&larr; My events</a>
<h1 class="h3 mt-2">@Model.Event.EventName</h1>
<p class="text-muted">@Model.Event.EventDate.ToString("d MMMM yyyy HH:mm") &middot; @Model.Event.Location</p>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header">Record a result</div>
            <div class="card-body">
                @if (!Model.Enrolments.Any())
                {
                    <p class="text-muted mb-0">No confirmed participants are waiting for a result.</p>
                }
                else
                {
                    <form asp-action="Manage" asp-route-eventId="@Model.Event.EventId" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="mb-3">
                            <label asp-for="EnrolmentId" class="form-label"></label>
                            <select asp-for="EnrolmentId" class="form-select"
                                    asp-items="@(new SelectList(Model.Enrolments, "EnrolmentId", "ParticipantName"))">
                                <option value="">-- select participant --</option>
                            </select>
                            <span asp-validation-for="EnrolmentId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Position" class="form-label"></label>
                            <input asp-for="Position" class="form-control" min="1" />
                            <span asp-validation-for="Position" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Time" class="form-label"></label>
                            <input asp-for="Time" class="form-control" type="number" step="0.001" min="0.001" />
                            <div class="form-text">e.g. 1534.250 for 25 min 34.25 s</div>
                            <span asp-validation-for="Time" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-success">Save result</button>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header">Recorded results</div>
            @if (!Model.Results.Any())
            {
                <div class="card-body text-muted">No results recorded yet.</div>
            }
            else
            {
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>#</th><th>Participant</th><th>Time</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var r in Model.Results)
                    {
                        <tr>
                            <td>@r.Position</td>
                            <td>@r.ParticipantName</td>
                            <td>@r.FormattedTime</td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-eventId="@Model.Event.EventId"
                                      asp-route-resultId="@r.ResultId" method="post"
                                      onsubmit="return confirm('Remove this result?');">
                                    <button class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>

        <div class="card shadow-sm">
            <div class="card-header">Enrolled participants (@Model.Enrolments.Count awaiting a result)</div>
            @if (!Model.Enrolments.Any())
            {
                <div class="card-body text-muted">Nobody is waiting for a result.</div>
            }
            else
            {
                <ul class="list-group list-group-flush">
                    @foreach (var p in Model.Enrolments)
                    {
                        <li class="list-group-item">@p.ParticipantName <span class="text-muted">&middot; @p.Email</span></li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
