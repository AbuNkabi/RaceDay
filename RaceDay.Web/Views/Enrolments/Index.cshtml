@model List<MyEnrolmentViewModel>
@{ ViewData["Title"] = "My Enrolments"; }

<h1 class="h3 mb-3">My enrolments</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        You haven't enrolled in any events yet.
        <a asp-controller="Events" asp-action="Index">Browse events</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>
                        @if (m.Event != null)
                        {
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@m.Event.EventId">@m.Event.EventName</a>
                        }
                        else { <span class="text-muted">Event no longer available</span> }
                    </td>
                    <td>@(m.Event?.EventDate.ToString("d MMM yyyy HH:mm") ?? "-")</td>
                    <td>@(m.Event?.Location ?? "-")</td>
                    <td>@m.Enrolment.Status</td>
                    <td class="text-end">
                        <form asp-action="Cancel" asp-route-id="@m.Enrolment.EnrolmentId" method="post" class="d-inline"
                              onsubmit="return confirm('Cancel your enrolment?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel enrolment</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
