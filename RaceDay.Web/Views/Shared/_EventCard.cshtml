@model EventModel
<div class="card h-100 shadow-sm event-card">
    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <img src="@Url.Action("Event", "Media", new { id = Model.EventId })" class="card-img-top" alt="@Model.EventName" />
    }
    else
    {
        <div class="placeholder-img card-img-top">🏃</div>
    }
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model.EventName</h5>
        <p class="card-text text-muted mb-1">📅 @Model.EventDate.ToString("dddd, d MMMM yyyy HH:mm")</p>
        <p class="card-text text-muted">📍 @Model.Location</p>
        <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.EventId"
           class="btn btn-primary mt-auto">View details</a>
    </div>
</div>
