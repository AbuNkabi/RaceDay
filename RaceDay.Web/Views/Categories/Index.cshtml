@model CategoryFormViewModel
@{ ViewData["Title"] = "Categories"; }
<h1 class="h3">Categories for @ViewBag.EventName</h1>
<table class="table table-striped"><thead><tr><th>Category</th><th>Entry fee</th><th>Capacity</th><th>Manage</th></tr></thead><tbody>
@foreach (var c in Model.Categories) { <tr><td>@c.CategoryName</td><td>R @c.EntryFee.ToString("0.00")</td><td>@c.MaximumParticipants</td><td>
<form asp-action="Update" method="post" class="d-flex flex-wrap gap-1 mb-1">
 <input type="hidden" name="EventId" value="@Model.EventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/>
 <input type="text" name="CategoryName" value="@c.CategoryName" required class="form-control form-control-sm" style="max-width:170px" aria-label="Category name"/>
 <input type="text" name="Description" value="@c.Description" class="form-control form-control-sm" style="max-width:130px" aria-label="Description"/>
 <input type="number" name="EntryFee" value="@c.EntryFee" step="0.01" min="0" class="form-control form-control-sm" style="max-width:90px" aria-label="Entry fee"/>
 <input type="number" name="MaximumParticipants" value="@c.MaximumParticipants" min="1" class="form-control form-control-sm" style="max-width:95px" aria-label="Capacity"/>
 <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
</form>
<form asp-action="Delete" method="post" onsubmit="return confirm('Delete this category?')">
 <input type="hidden" name="eventId" value="@Model.EventId"/><input type="hidden" name="categoryId" value="@c.CategoryId"/>
 <button class="btn btn-sm btn-outline-danger">Delete</button>
</form>
</td></tr> }
</tbody></table>
<h2 class="h5">Add category</h2>
<form asp-action="Create" method="post">
<input asp-for="EventId" type="hidden" />
<div class="mb-2"><label asp-for="CategoryName"></label><input asp-for="CategoryName" class="form-control" required /></div>
<div class="mb-2"><label asp-for="Description"></label><input asp-for="Description" class="form-control" /></div>
<div class="mb-2"><label asp-for="EntryFee"></label><input asp-for="EntryFee" type="number" step="0.01" min="0" class="form-control" /></div>
<div class="mb-2"><label asp-for="MaximumParticipants"></label><input asp-for="MaximumParticipants" type="number" min="1" class="form-control" /></div>
<button class="btn btn-primary">Add category</button>
</form>
